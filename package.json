{
  "name": "caesar",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-provider coding sub-agent orchestrator (Antigravity, Codex, OpenCode, Copilot, Claude)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --noEmit false --dry 2>/dev/null || tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "caesar": "node packages/cli/dist/bin.js",
    "build:binary": "bash scripts/build-binary.sh",
    "assets:sync": "node scripts/generate-agent-assets.mjs",
    "og:build": "node scripts/generate-og.mjs",
    "website:start": "pnpm --filter website start",
    "website:build": "pnpm --filter website build"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^24.10.1",
    "fontkit": "2.0.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "wawoff2": "2.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js"
    ]
  }
}
