{
  "name": "agent-orchestrateur",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestrateur de sous-agents de code multi-providers (Antigravity, Codex, OpenCode, Copilot, Claude)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --noEmit false --dry 2>/dev/null || tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "orch": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
