{
  // This package runs under Bun, which executes TypeScript directly: this
  // file serves only the typecheck (`tsc --noEmit`, see the "typecheck"
  // script), never a compilation another package would depend on.
  // Deliberately absent from the root `tsconfig.json` references
  // (`pnpm exec tsc -b` does not see it) and deliberately non-composite:
  // composite implies emitting declarations meant for consumers, which no
  // package does here.
  //
  // Does not extend `tsconfig.base.json` (module: NodeNext): OpenTUI ships
  // its JSX typings (`box`, `text`, `select`…) under the `@opentui/react`
  // export with `moduleResolution: "bundler"`, the configuration its own
  // README recommends — Bun understands it natively. The monorepo's
  // strictness options (`strict`, `noUncheckedIndexedAccess`,
  // `verbatimModuleSyntax`…) are restated explicitly to stay consistent
  // with the other packages.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "composite": false,
    "noEmit": true
  },
  "include": ["src/**/*"]
}
